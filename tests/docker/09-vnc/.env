# LinuxServer Webtop 镜像及运行参数
WEBTOP_IMAGE_TAG=ubuntu-xfce
WEBTOP_SHM_SIZE=1gb

# 宿主机目录权限。执行 `id` 获取当前用户的 UID/GID。
PUID=1000
PGID=1000

TZ=Asia/Shanghai
LC_ALL=C.UTF-8

# false 兼容无 GPU、旧 CPU 或部分虚拟机环境。
PIXELFLUX_WAYLAND=false
DISABLE_IPV6=true

# 默认仅监听宿主机回环地址。
# 局域网访问可改成宿主机实际 LAN IP，例如 192.168.1.10。
# 不建议直接设置为 0.0.0.0 并暴露到公网。
VNC_BIND_HOST=10.10.50.30

# 三个独立桌面的 HTTPS 端口
VNC_HTTPS_PORT_01=30011
VNC_HTTPS_PORT_02=30012
VNC_HTTPS_PORT_03=30013

# 测试用户 01
VNC_USER_01=vnc_test01
VNC_PASSWORD_01=Q7mP2vN9xR4cT8kL6sD3hW5z

# 测试用户 02
VNC_USER_02=vnc_test02
VNC_PASSWORD_02=B6yF9qJ2nV8rK4mC7tX5pL3w

# 测试用户 03
VNC_USER_03=vnc_test03
VNC_PASSWORD_03=H8sM3dR7vN2kQ9cT4xP6jL5b
