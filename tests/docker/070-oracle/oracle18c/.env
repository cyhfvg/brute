# ==================================================
# Oracle XE 18c 镜像
# ==================================================

# 固定使用 Oracle Database XE 18c 18.4.0
ORACLE_IMAGE=gvenzl/oracle-xe:18.4.0

# 可选的镜像类型：
#
# 普通版：
# ORACLE_IMAGE=gvenzl/oracle-xe:18.4.0
#
# 精简版：
# ORACLE_IMAGE=gvenzl/oracle-xe:18.4.0-slim
#
# 快速启动版通常更适合无持久化的自动化测试：
# ORACLE_IMAGE=gvenzl/oracle-xe:18.4.0-faststart


# ==================================================
# 容器配置
# ==================================================

ORACLE_CONTAINER_NAME=oracle18c
ORACLE_HOSTNAME=oracle18c


# ==================================================
# 网络配置
# ==================================================

# 仅允许宿主机本地访问
ORACLE_BIND_HOST=0.0.0.0

# Oracle Listener
ORACLE_PORT=1521

# Enterprise Manager Express
ORACLE_EM_PORT=5500


# ==================================================
# Oracle 管理员账号
# ==================================================

# 同时用于初始化 SYS 和 SYSTEM 用户
#
# 仅在数据库数据卷第一次初始化时生效。
# 请替换为实际强密码。
ORACLE_PASSWORD=orac_sys_Oracle18c_A9x7!


# ==================================================
# 普通应用用户
# ==================================================

# APP_USER 默认创建在 XEPDB1 中
ORACLE_APP_USER=APPUSER
ORACLE_APP_PASSWORD=orac_norm_AppUser_K8p4!


# ==================================================
# 可选：额外创建一个 PDB
# ==================================================

# 默认已有 XEPDB1，一般不需要再创建。
#
# 如需额外创建 APPPDB：
# 1. 取消 docker-compose.yml 中 ORACLE_DATABASE 的注释
# 2. 设置下面的变量
#
# ORACLE_DATABASE=APPPDB


# ==================================================
# 运行环境
# ==================================================

TZ=Asia/Shanghai
ORACLE_SHM_SIZE=1g


# ==================================================
# Docker 资源名称
# ==================================================

ORACLE_VOLUME_NAME=oracle18c_data
ORACLE_NETWORK_NAME=oracle18c_network
